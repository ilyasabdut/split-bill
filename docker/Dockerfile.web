FROM oven/bun:latest AS builder

WORKDIR /app

COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile

COPY web/ ./

# Vite inlines these into the static bundle at build time
ARG VITE_FASTAPI_API_URL
ARG VITE_API_KEY
ENV VITE_FASTAPI_API_URL=$VITE_FASTAPI_API_URL
ENV VITE_API_KEY=$VITE_API_KEY
RUN bun run build

FROM oven/bun:slim AS final

WORKDIR /app

# Install 'serve' utility to serve static files
RUN bun add -g serve

COPY --from=builder /app/build ./build

EXPOSE 3000

ENV NODE_ENV=production

# Serve static build on port 3000
CMD ["serve", "-s", "build", "-p", "3000"]
