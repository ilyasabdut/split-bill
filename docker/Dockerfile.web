FROM oven/bun:latest AS builder

WORKDIR /app

COPY web/package.json web/bun.lock ./
RUN bun install --frozen-lockfile

COPY web/ ./

# No build-time config: the app calls /api on its own origin (see nginx.conf.template)
RUN bun run build

FROM nginx:alpine AS final

# The nginx image renders templates with envsubst at start (API_KEY comes from the environment)
ENV NGINX_ENVSUBST_FILTER=API_KEY
COPY docker/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY --from=builder /app/build /usr/share/nginx/html

EXPOSE 80
