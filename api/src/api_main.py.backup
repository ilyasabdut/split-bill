"""
Main FastAPI application with modular router structure.
"""

import logging
import os
import sys
from contextlib import asynccontextmanager
from typing import Optional

from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware

# Add current directory to path for imports
sys.path.insert(0, os.path.dirname(__file__))

# Configure logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# Import cache service
cache_service: Optional[object] = None
try:
    from core.cache import cache_service

    logger.info("Cache service imported successfully")
except ImportError as e:
    logger.warning(f"Cache service not available: {e}")

# Import routers
try:
    from routers import health_router, receipts_router, splits_router
    logger.info("Routers imported successfully")
    health = health_router
    receipts = receipts_router
    splits = splits_router
except ImportError as e:
    logger.error(f"Failed to import routers: {e}")
    health = receipts = splits = None


@asynccontextmanager
async def lifespan(app: FastAPI):
    """Application lifespan management."""
    # Startup
    logger.info("Starting Split Bill API...")

    current_cache_service = cache_service
    if current_cache_service:
        try:
            await current_cache_service.connect()
            logger.info("Cache service connected successfully")
        except Exception as e:
            logger.error(f"Failed to connect cache service: {e}")
            current_cache_service = None  # Disable cache if connection fails
    else:
        logger.warning("Cache service not available - running without caching")

    yield

    # Shutdown
    logger.info("Shutting down Split Bill API...")
    if current_cache_service:
        try:
            await current_cache_service.disconnect()
            logger.info("Cache service disconnected successfully")
        except Exception as e:
            logger.error(f"Error disconnecting cache service: {e}")


# Create FastAPI app
app = FastAPI(
    title="Bill Splitter API",
    description="API for uploading receipts, extracting data, and calculating bill splits.",
    version="1.0.0",
    docs_url="/docs",
    redoc_url="/redoc",
    openapi_url="/openapi.json",
    lifespan=lifespan,
)

# Add CORS middleware
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],  # In production, restrict to specific origins
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)

# Include routers if available
if health and receipts and splits:
    app.include_router(health.router)
    app.include_router(receipts.router)
    app.include_router(splits.router)
    logger.info("Routers included successfully")
else:
    logger.error("Routers not available - API will have limited functionality")


# Root endpoint
@app.get("/")
async def root():
    """Root endpoint with API information."""
    return {
        "message": "Bill Splitter API is running",
        "version": "1.0.0",
        "docs": "/docs",
        "health": "/health",
        "cache_enabled": cache_service is not None,
    }


# Global exception handler
@app.exception_handler(HTTPException)
async def http_exception_handler(request, exc):
    """Global HTTP exception handler."""
    return {
        "error": {
            "type": "HTTPException",
            "status_code": exc.status_code,
            "detail": exc.detail,
        }
    }


# Global exception handler for unexpected errors
@app.exception_handler(Exception)
async def general_exception_handler(request, exc):
    """Global exception handler for unexpected errors."""
    return {
        "error": {
            "type": "InternalServerError",
            "status_code": 500,
            "detail": "An unexpected error occurred",
        }
    }


if __name__ == "__main__":
    import uvicorn

    uvicorn.run(
        "api_main:app", host="0.0.0.0", port=8000, reload=True, log_level="info"
    )
