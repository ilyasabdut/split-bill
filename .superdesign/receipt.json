{
  "draftId": "b2aac2f8-16a9-442f-a604-6766cc81b3e4",
  "title": "Split Bill — Receipt Analysis Results",
  "htmlContent": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <meta name=\"color-scheme\" content=\"light\" />\n  <title>Split Bill — Scan Receipt</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <script src=\"https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js\"></script>\n  <script>\n    tailwind.config = {\n      theme: {\n        extend: {\n          colors: {\n            brand: {\n              50: '#f0f9ff',\n              100: '#e0f2fe',\n              200: '#bae6fd',\n              300: '#7dd3fc',\n              400: '#38bdf8',\n              500: '#0ea5e9',\n              600: '#0284c7',\n              700: '#0369a1'\n            }\n          }\n        }\n      }\n    }\n  </script>\n</head>\n<body>\n  <div class=\"w-full h-screen flex flex-col bg-slate-50 text-slate-900\">\n    <!-- Header (safe area) -->\n    <header class=\"shrink-0 pt-14 px-4\">\n      <div class=\"flex items-center justify-between\">\n        <a id=\"scan-back-link\" href=\"#\" class=\"h-11 w-11 inline-flex items-center justify-center rounded-xl bg-white shadow-md shadow-slate-200 ring-1 ring-slate-200 active:scale-[0.98] transition\">\n          <iconify-icon icon=\"lucide:chevron-left\" class=\"text-xl text-slate-700\"></iconify-icon>\n        </a>\n\n        <div class=\"text-center\">\n          <p class=\"text-sm font-semibold tracking-tight\">Scan Receipt</p>\n          <p class=\"text-xs text-slate-500\">Upload or use your camera</p>\n        </div>\n\n        <a id=\"scan-help-link\" href=\"#\" class=\"h-11 w-11 inline-flex items-center justify-center rounded-xl bg-white shadow-md shadow-slate-200 ring-1 ring-slate-200 active:scale-[0.98] transition\">\n          <iconify-icon icon=\"lucide:help-circle\" class=\"text-xl text-slate-700\"></iconify-icon>\n        </a>\n      </div>\n    </header>\n\n    <!-- Main -->\n    <main class=\"flex-1 overflow-y-auto px-4 pt-5 pb-6\">\n      <!-- Brand hint -->\n      <div class=\"flex items-center gap-3\">\n        <div class=\"h-10 w-10 rounded-2xl bg-brand-500 shadow-md shadow-brand-200 flex items-center justify-center\">\n          <iconify-icon icon=\"lucide:scan-line\" class=\"text-white text-xl\"></iconify-icon>\n        </div>\n        <div>\n          <h1 class=\"text-lg font-semibold leading-tight tracking-tight\">Capture a clear photo</h1>\n          <p class=\"text-sm text-slate-600\">We’ll extract items and totals automatically.</p>\n        </div>\n      </div>\n\n      <!-- Upload zone -->\n      <section class=\"mt-5\">\n        <button type=\"button\" class=\"w-full rounded-3xl bg-white shadow-md shadow-slate-200 ring-1 ring-slate-200 active:scale-[0.99] transition\">\n          <div class=\"p-4\">\n            <div class=\"rounded-3xl border-2 border-dashed border-brand-400 bg-brand-50\">\n              <div class=\"px-5 py-10\">\n                <div class=\"mx-auto flex flex-col items-center\">\n                  <div class=\"h-20 w-20 rounded-3xl bg-white ring-1 ring-brand-200 shadow-md shadow-brand-100 flex items-center justify-center\">\n                    <iconify-icon icon=\"lucide:camera\" class=\"text-3xl text-brand-600\"></iconify-icon>\n                  </div>\n\n                  <p class=\"mt-4 text-base font-semibold\">Tap to scan</p>\n                  <p class=\"mt-1 text-sm text-slate-600 text-center\">Or upload a photo/PDF of your receipt</p>\n\n                  <div class=\"mt-5 flex items-center gap-10\">\n                    <div class=\"flex items-center gap-2 text-xs text-slate-600\">\n                      <span class=\"h-8 w-8 rounded-xl bg-white ring-1 ring-slate-200 flex items-center justify-center\">\n                        <iconify-icon icon=\"lucide:sparkles\" class=\"text-base text-brand-600\"></iconify-icon>\n                      </span>\n                      <span>Auto-detect totals</span>\n                    </div>\n                    <div class=\"flex items-center gap-2 text-xs text-slate-600\">\n                      <span class=\"h-8 w-8 rounded-xl bg-white ring-1 ring-slate-200 flex items-center justify-center\">\n                        <iconify-icon icon=\"lucide:shield-check\" class=\"text-base text-brand-600\"></iconify-icon>\n                      </span>\n                      <span>Private by default</span>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </button>\n\n        <!-- Secondary action -->\n        <div class=\"mt-3 grid grid-cols-2 gap-3\">\n          <button type=\"button\" class=\"h-12 rounded-2xl bg-brand-500 text-white font-semibold shadow-md shadow-brand-200 active:scale-[0.98] transition inline-flex items-center justify-center gap-2\">\n            <iconify-icon icon=\"lucide:camera\" class=\"text-lg\"></iconify-icon>\n            <span class=\"text-sm\">Open Camera</span>\n          </button>\n          <button type=\"button\" class=\"h-12 rounded-2xl bg-white text-slate-800 font-semibold shadow-md shadow-slate-200 ring-1 ring-slate-200 active:scale-[0.98] transition inline-flex items-center justify-center gap-2\">\n            <iconify-icon icon=\"lucide:upload\" class=\"text-lg text-brand-600\"></iconify-icon>\n            <span class=\"text-sm\">Upload File</span>\n          </button>\n        </div>\n      </section>\n\n      <!-- Results / Analysis Section (Replaces previous processing state) -->\n      <section class=\"mt-6 rounded-3xl bg-white shadow-md shadow-slate-200 ring-1 ring-slate-200 overflow-hidden\">\n        <!-- Confidence Header -->\n        <div class=\"px-4 py-3 bg-slate-50 border-b border-slate-100 flex items-center justify-between\">\n          <div class=\"flex items-center gap-2\">\n            <div class=\"h-5 w-5 rounded-full bg-green-500 flex items-center justify-center\">\n              <iconify-icon icon=\"lucide:check\" class=\"text-xs text-white\"></iconify-icon>\n            </div>\n            <span class=\"text-xs font-bold text-slate-700 uppercase tracking-wider\">Scan Complete</span>\n          </div>\n          <div class=\"flex items-center gap-1.5 rounded-full bg-green-50 px-2 py-1 ring-1 ring-green-200\">\n            <iconify-icon icon=\"lucide:sparkles\" class=\"text-[10px] text-green-600\"></iconify-icon>\n            <span class=\"text-xs font-bold text-green-700\">98% Confidence</span>\n          </div>\n        </div>\n\n        <div class=\"p-4\">\n          <!-- Detected Items List -->\n          <div class=\"space-y-3\">\n            <!-- Item 1 -->\n            <div class=\"flex items-center gap-3 group\">\n              <button class=\"shrink-0 h-6 w-6 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center hover:bg-red-50 hover:text-red-500 transition\">\n                <iconify-icon icon=\"lucide:minus\" class=\"text-xs\"></iconify-icon>\n              </button>\n              <div class=\"flex-1 min-w-0\">\n                <input type=\"text\" value=\"Double Cheeseburger\" class=\"w-full border-none bg-transparent p-0 text-sm font-semibold text-slate-900 focus:ring-0 truncate placeholder-slate-400\">\n              </div>\n              <div class=\"flex items-center gap-1 shrink-0\">\n                <span class=\"text-xs text-slate-400\">$</span>\n                <input type=\"text\" value=\"14.50\" class=\"w-12 border-none bg-transparent p-0 text-right text-sm font-bold text-slate-900 focus:ring-0\">\n              </div>\n            </div>\n            \n            <!-- Item 2 -->\n            <div class=\"flex items-center gap-3 group\">\n              <button class=\"shrink-0 h-6 w-6 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center hover:bg-red-50 hover:text-red-500 transition\">\n                <iconify-icon icon=\"lucide:minus\" class=\"text-xs\"></iconify-icon>\n              </button>\n              <div class=\"flex-1 min-w-0\">\n                <input type=\"text\" value=\"Sweet Potato Fries\" class=\"w-full border-none bg-transparent p-0 text-sm font-semibold text-slate-900 focus:ring-0 truncate placeholder-slate-400\">\n              </div>\n              <div class=\"flex items-center gap-1 shrink-0\">\n                <span class=\"text-xs text-slate-400\">$</span>\n                <input type=\"text\" value=\"6.00\" class=\"w-12 border-none bg-transparent p-0 text-right text-sm font-bold text-slate-900 focus:ring-0\">\n              </div>\n            </div>\n\n            <!-- Item 3 -->\n            <div class=\"flex items-center gap-3 group\">\n              <button class=\"shrink-0 h-6 w-6 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center hover:bg-red-50 hover:text-red-500 transition\">\n                <iconify-icon icon=\"lucide:minus\" class=\"text-xs\"></iconify-icon>\n              </button>\n              <div class=\"flex-1 min-w-0\">\n                <input type=\"text\" value=\"Vanilla Shake\" class=\"w-full border-none bg-transparent p-0 text-sm font-semibold text-slate-900 focus:ring-0 truncate placeholder-slate-400\">\n              </div>\n              <div class=\"flex items-center gap-1 shrink-0\">\n                <span class=\"text-xs text-slate-400\">$</span>\n                <input type=\"text\" value=\"5.50\" class=\"w-12 border-none bg-transparent p-0 text-right text-sm font-bold text-slate-900 focus:ring-0\">\n              </div>\n            </div>\n            \n            <div class=\"pt-1 flex items-center justify-between\">\n              <button class=\"flex items-center gap-1.5 text-xs font-bold text-brand-600 active:text-brand-700\">\n                <iconify-icon icon=\"lucide:plus-circle\" class=\"text-base\"></iconify-icon>\n                Add Item\n              </button>\n              <span class=\"text-xs font-medium text-slate-400\">Subtotal: $26.00</span>\n            </div>\n          </div>\n\n          <!-- Tax & Total Section -->\n          <div class=\"mt-4 pt-4 border-t border-slate-100 space-y-3\">\n            <!-- Tax Toggle -->\n            <div class=\"flex items-center justify-between\">\n              <div class=\"flex items-center gap-2\">\n                <div class=\"h-7 w-7 rounded-lg bg-orange-50 flex items-center justify-center text-orange-500\">\n                  <iconify-icon icon=\"lucide:percent\" class=\"text-sm\"></iconify-icon>\n                </div>\n                <div class=\"leading-none\">\n                  <p class=\"text-xs font-bold text-slate-700\">Tax Detected: 10%</p>\n                  <button class=\"text-[10px] font-medium text-brand-600 underline decoration-brand-200 underline-offset-2 mt-0.5\">Edit Rate</button>\n                </div>\n              </div>\n              <!-- Toggle Switch -->\n              <button class=\"relative h-6 w-10 rounded-full bg-brand-500 transition-colors focus:outline-none\">\n                <span class=\"absolute right-1 top-1 h-4 w-4 rounded-full bg-white shadow-sm transition-transform\"></span>\n              </button>\n            </div>\n\n            <!-- Total Card -->\n            <div class=\"flex items-center justify-between rounded-xl bg-slate-50 p-3 ring-1 ring-slate-100\">\n              <span class=\"text-sm font-semibold text-slate-600\">Total Amount</span>\n              <div class=\"flex items-baseline gap-1\">\n                <span class=\"text-xs font-bold text-slate-400\">USD</span>\n                <span class=\"text-xl font-bold text-slate-900\">$28.60</span>\n              </div>\n            </div>\n          </div>\n\n          <!-- Actions -->\n          <div class=\"mt-5 grid grid-cols-2 gap-3\">\n            <button class=\"flex h-10 items-center justify-center gap-2 rounded-xl bg-white text-xs font-bold text-slate-700 shadow-sm ring-1 ring-slate-200 active:scale-[0.98] transition\">\n              <iconify-icon icon=\"lucide:share-2\" class=\"text-sm text-slate-500\"></iconify-icon>\n              Share\n            </button>\n            <button class=\"flex h-10 items-center justify-center gap-2 rounded-xl bg-brand-500 text-xs font-bold text-white shadow-md shadow-brand-200 active:scale-[0.98] transition\">\n              <span>Confirm</span>\n              <iconify-icon icon=\"lucide:arrow-right\" class=\"text-sm\"></iconify-icon>\n            </button>\n          </div>\n        </div>\n      </section>\n\n      <!-- Help text -->\n      <section class=\"mt-6 rounded-3xl bg-brand-50 ring-1 ring-brand-200\">\n        <div class=\"p-4\">\n          <div class=\"flex items-start gap-3\">\n            <div class=\"h-11 w-11 rounded-2xl bg-white ring-1 ring-brand-200 flex items-center justify-center\">\n              <iconify-icon icon=\"lucide:info\" class=\"text-xl text-brand-600\"></iconify-icon>\n            </div>\n            <div class=\"flex-1\">\n              <p class=\"text-sm font-semibold\">Tips for best results</p>\n              <ul class=\"mt-2 space-y-2 text-sm text-slate-700\">\n                <li class=\"flex gap-2\">\n                  <span class=\"mt-1.5 h-1.5 w-1.5 rounded-full bg-brand-500 shrink-0\"></span>\n                  <span>Place receipt on a flat surface with good lighting.</span>\n                </li>\n                <li class=\"flex gap-2\">\n                  <span class=\"mt-1.5 h-1.5 w-1.5 rounded-full bg-brand-500 shrink-0\"></span>\n                  <span>Make sure the total and tax are visible in the photo.</span>\n                </li>\n                <li class=\"flex gap-2\">\n                  <span class=\"mt-1.5 h-1.5 w-1.5 rounded-full bg-brand-500 shrink-0\"></span>\n                  <span>Keep the camera steady—no blur.</span>\n                </li>\n              </ul>\n              <div class=\"mt-4 flex gap-3\">\n                <a id=\"scan-learn-more-link\" href=\"#\" class=\"h-11 px-4 inline-flex items-center justify-center rounded-2xl bg-white ring-1 ring-brand-200 text-sm font-semibold text-brand-700 shadow-md shadow-brand-100 active:scale-[0.98] transition\">\n                  Learn more\n                </a>\n                <a id=\"scan-troubleshoot-link\" href=\"#\" class=\"h-11 px-4 inline-flex items-center justify-center rounded-2xl bg-brand-500 text-sm font-semibold text-white shadow-md shadow-brand-200 active:scale-[0.98] transition\">\n                  Troubleshoot\n                </a>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- Extra spacing so content doesn't sit under bottom nav -->\n      <div class=\"h-24\"></div>\n    </main>\n\n    <!-- Bottom Navigation (solid bg + safe area) -->\n    <footer class=\"shrink-0 pb-[34px]\">\n      <nav class=\"w-full bg-white border-t border-slate-200\">\n        <div class=\"px-3 pt-2\">\n          <div class=\"grid grid-cols-4 gap-2\">\n            <a id=\"bottom-home-link\" href=\"#\" class=\"h-14 rounded-2xl inline-flex flex-col items-center justify-center gap-1 text-slate-600 active:scale-[0.98] transition\">\n              <iconify-icon icon=\"lucide:home\" class=\"text-xl\"></iconify-icon>\n              <span class=\"text-xs font-semibold\">Home</span>\n            </a>\n\n            <a id=\"bottom-history-link\" href=\"#\" class=\"h-14 rounded-2xl inline-flex flex-col items-center justify-center gap-1 text-slate-600 active:scale-[0.98] transition\">\n              <iconify-icon icon=\"lucide:clock\" class=\"text-xl\"></iconify-icon>\n              <span class=\"text-xs font-semibold\">History</span>\n            </a>\n\n            <!-- Active: Scan -->\n            <a id=\"bottom-scan-link\" href=\"#\" class=\"h-14 rounded-2xl inline-flex flex-col items-center justify-center gap-1 bg-brand-50 text-brand-700 ring-1 ring-brand-200 active:scale-[0.98] transition\">\n              <span class=\"h-9 w-9 rounded-2xl bg-brand-500 shadow-md shadow-brand-200 inline-flex items-center justify-center\">\n                <iconify-icon icon=\"lucide:plus\" class=\"text-white text-xl\"></iconify-icon>\n              </span>\n              <span class=\"text-xs font-extrabold\">Scan</span>\n            </a>\n\n            <a id=\"bottom-settings-link\" href=\"#\" class=\"h-14 rounded-2xl inline-flex flex-col items-center justify-center gap-1 text-slate-600 active:scale-[0.98] transition\">\n              <iconify-icon icon=\"lucide:settings\" class=\"text-xl\"></iconify-icon>\n              <span class=\"text-xs font-semibold\">Settings</span>\n            </a>\n          </div>\n        </div>\n      </nav>\n    </footer>\n  </div>\n</body>\n</html>"
}
