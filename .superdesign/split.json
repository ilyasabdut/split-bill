{
  "draftId": "32cc29f9-f406-468d-9eff-91bf233253ab",
  "title": "Create Split — Enhanced IDR",
  "htmlContent": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <meta name=\"color-scheme\" content=\"light\" />\n  <title>Split Bill — Create Split</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <script src=\"https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js\"></script>\n  <script>\n    tailwind.config = {\n      theme: {\n        extend: {\n          colors: {\n            brand: {\n              50: '#effaff',\n              100: '#d7f2ff',\n              200: '#b5e7ff',\n              300: '#7fd6ff',\n              400: '#3fc2ff',\n              500: '#0ea5e9',\n              600: '#0284c7',\n              700: '#0369a1',\n              800: '#075985',\n              900: '#0c4a6e'\n            }\n          },\n          fontFamily: {\n            sans: ['Inter', 'sans-serif']\n          }\n        }\n      }\n    }\n  </script>\n</head>\n<body>\n  <div class=\"w-full h-screen flex flex-col bg-slate-50 text-slate-900 font-sans\">\n    <!-- Header (safe area) -->\n    <header class=\"shrink-0 pt-12 px-4 pb-2 z-10\">\n      <div class=\"flex items-center justify-between\">\n        <a id=\"nav-back-btn\" href=\"#\" class=\"h-11 w-11 inline-flex items-center justify-center rounded-2xl bg-white shadow-sm border border-slate-200 active:scale-95 transition-transform\">\n          <iconify-icon icon=\"lucide:chevron-left\" class=\"text-xl text-slate-700\"></iconify-icon>\n        </a>\n        <div class=\"text-center\">\n          <div class=\"text-xs font-bold text-slate-500 uppercase tracking-wider\">New Split</div>\n          <h1 class=\"text-lg font-black tracking-tight text-slate-900\">Bill Details</h1>\n        </div>\n        <button id=\"nav-more-btn\" type=\"button\" class=\"h-11 w-11 inline-flex items-center justify-center rounded-2xl bg-white shadow-sm border border-slate-200 active:scale-95 transition-transform\" aria-label=\"More options\">\n          <iconify-icon icon=\"lucide:more-vertical\" class=\"text-xl text-slate-700\"></iconify-icon>\n        </button>\n      </div>\n    </header>\n\n    <!-- Main Scrollable Area -->\n    <main class=\"flex-1 overflow-y-auto px-4 py-4 pb-[120px] space-y-5\">\n      \n      <!-- Amounts Card -->\n      <section class=\"rounded-3xl bg-white shadow-md border border-slate-200 overflow-hidden\">\n        <!-- Currency Selector Header -->\n        <div class=\"px-5 py-3 border-b border-slate-100 flex items-center justify-between bg-slate-50/50\">\n          <span class=\"text-xs font-bold text-slate-500 uppercase tracking-wider\">Currency</span>\n          <button type=\"button\" class=\"flex items-center gap-2 px-3 py-1.5 rounded-xl bg-white border border-slate-200 shadow-sm text-sm font-bold text-slate-800 active:scale-95 transition-transform hover:bg-slate-50\">\n            <span class=\"text-lg\">🇮🇩</span>\n            <span>IDR (Rp)</span>\n            <iconify-icon icon=\"lucide:chevron-down\" class=\"text-xs opacity-50\"></iconify-icon>\n          </button>\n        </div>\n\n        <div class=\"p-5 space-y-5\">\n          <!-- Bill Amount -->\n          <div>\n            <label for=\"bill-amount\" class=\"block text-sm font-bold text-slate-700 mb-2\">Bill Amount</label>\n            <div class=\"relative group\">\n              <span class=\"absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-bold text-lg\">Rp</span>\n              <input id=\"bill-amount\" name=\"bill-amount\" inputmode=\"numeric\" value=\"740.000\" class=\"h-14 w-full rounded-2xl border border-slate-200 bg-slate-50 pl-12 pr-4 text-xl font-bold text-slate-900 shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all placeholder:text-slate-300\" />\n            </div>\n          </div>\n\n          <!-- Tax Field (New) -->\n          <div>\n            <div class=\"flex items-center justify-between mb-2\">\n              <label for=\"tax-amount\" class=\"block text-sm font-bold text-slate-700\">Tax</label>\n              <button type=\"button\" class=\"text-xs font-bold text-brand-600 flex items-center gap-1 hover:text-brand-700 transition-colors bg-brand-50 px-2 py-1 rounded-lg\">\n                <iconify-icon icon=\"lucide:zap\" class=\"text-sm\"></iconify-icon>\n                Auto-detect\n              </button>\n            </div>\n            <div class=\"relative\">\n              <span class=\"absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-bold\">Rp</span>\n              <input id=\"tax-amount\" name=\"tax-amount\" inputmode=\"numeric\" placeholder=\"0\" class=\"h-12 w-full rounded-2xl border border-slate-200 bg-slate-50 pl-12 pr-4 text-base font-bold text-slate-900 shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all\" />\n            </div>\n            <p class=\"mt-1.5 text-xs text-slate-400 font-medium\">If not included in bill amount.</p>\n          </div>\n\n          <!-- Tip Section -->\n          <div>\n            <div class=\"flex items-center justify-between mb-2\">\n              <label for=\"tip-amount\" class=\"block text-sm font-bold text-slate-700\">Tip</label>\n              <span class=\"text-[10px] font-bold text-slate-400 bg-slate-100 px-2 py-0.5 rounded-full\">OPTIONAL</span>\n            </div>\n            <div class=\"relative mb-3\">\n              <span class=\"absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 font-bold\">Rp</span>\n              <input id=\"tip-amount\" name=\"tip-amount\" inputmode=\"numeric\" value=\"50.000\" class=\"h-12 w-full rounded-2xl border border-slate-200 bg-slate-50 pl-12 pr-4 text-base font-bold text-slate-900 shadow-sm focus:outline-none focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all\" />\n            </div>\n            \n            <!-- Quick Tip Grid -->\n            <div class=\"grid grid-cols-4 gap-2\">\n              <button type=\"button\" class=\"h-10 rounded-xl bg-slate-50 border border-slate-200 text-slate-600 text-xs font-bold hover:bg-brand-50 hover:border-brand-200 hover:text-brand-700 transition-colors\">15%</button>\n              <button type=\"button\" class=\"h-10 rounded-xl bg-slate-50 border border-slate-200 text-slate-600 text-xs font-bold hover:bg-brand-50 hover:border-brand-200 hover:text-brand-700 transition-colors\">18%</button>\n              <button type=\"button\" class=\"h-10 rounded-xl bg-brand-500 border border-brand-600 text-white text-xs font-bold shadow-sm ring-2 ring-brand-100 ring-offset-1\">20%</button>\n              <button type=\"button\" class=\"h-10 rounded-xl bg-slate-50 border border-slate-200 text-slate-600 text-xs font-bold hover:bg-brand-50 hover:border-brand-200 hover:text-brand-700 transition-colors\">Custom</button>\n            </div>\n          </div>\n        </div>\n        \n        <!-- Total Footer -->\n        <div class=\"bg-slate-50 px-5 py-4 border-t border-slate-200\">\n          <div class=\"flex items-end justify-between\">\n            <div class=\"text-sm font-bold text-slate-500\">Estimated Total</div>\n            <div class=\"text-2xl font-black text-slate-900 tracking-tight\">Rp 790.000</div>\n          </div>\n        </div>\n      </section>\n\n      <!-- Smart Rounding Options -->\n      <section class=\"rounded-3xl bg-white shadow-md border border-slate-200 p-5\">\n        <div class=\"flex items-center justify-between mb-3\">\n          <h2 class=\"text-sm font-bold text-slate-900\">Smart Rounding</h2>\n          <span class=\"text-[10px] font-bold text-brand-700 bg-brand-100 px-2 py-0.5 rounded-lg\">ACTIVE</span>\n        </div>\n        <div class=\"grid grid-cols-3 gap-1 p-1 bg-slate-100 rounded-2xl mb-3\">\n          <button type=\"button\" class=\"py-2.5 rounded-xl text-xs font-bold text-slate-600 hover:bg-white hover:shadow-sm transition-all\">Down</button>\n          <button type=\"button\" class=\"py-2.5 rounded-xl bg-white shadow-sm text-xs font-bold text-slate-900 ring-1 ring-black/5\">Exact</button>\n          <button type=\"button\" class=\"py-2.5 rounded-xl text-xs font-bold text-slate-600 hover:bg-white hover:shadow-sm transition-all\">Up</button>\n        </div>\n        <div class=\"flex items-start gap-2.5 rounded-xl bg-slate-50 border border-slate-100 p-3\">\n          <iconify-icon icon=\"lucide:info\" class=\"text-sm text-brand-500 mt-0.5 shrink-0\"></iconify-icon>\n          <p class=\"text-xs text-slate-600 font-medium leading-relaxed\">Total will be exactly <span class=\"font-bold text-slate-900\">Rp 790.000</span>. No rounding applied.</p>\n        </div>\n      </section>\n\n      <!-- Split Style Tabs -->\n      <section class=\"rounded-3xl bg-white shadow-md border border-slate-200 overflow-hidden\">\n        <div class=\"px-5 py-3 border-b border-slate-100\">\n          <h2 class=\"text-sm font-bold text-slate-900\">Split Method</h2>\n        </div>\n        <div class=\"p-5\">\n          <div class=\"grid grid-cols-3 gap-3 mb-4\">\n            <button type=\"button\" class=\"flex flex-col items-center justify-center gap-2 h-20 rounded-2xl bg-brand-50 border-2 border-brand-500 text-brand-700 transition-all active:scale-[0.98]\">\n              <iconify-icon icon=\"lucide:equal\" class=\"text-2xl\"></iconify-icon>\n              <span class=\"text-xs font-extrabold\">Equal</span>\n            </button>\n            <button type=\"button\" class=\"flex flex-col items-center justify-center gap-2 h-20 rounded-2xl bg-white border border-slate-200 text-slate-600 hover:border-slate-300 transition-all active:scale-[0.98]\">\n              <iconify-icon icon=\"lucide:percent\" class=\"text-2xl\"></iconify-icon>\n              <span class=\"text-xs font-bold\">% Split</span>\n            </button>\n            <button type=\"button\" class=\"flex flex-col items-center justify-center gap-2 h-20 rounded-2xl bg-white border border-slate-200 text-slate-600 hover:border-slate-300 transition-all active:scale-[0.98]\">\n              <iconify-icon icon=\"lucide:receipt\" class=\"text-2xl\"></iconify-icon>\n              <span class=\"text-xs font-bold\">By Item</span>\n            </button>\n          </div>\n          <div class=\"flex items-start gap-3\">\n             <div class=\"h-10 w-10 shrink-0 rounded-full bg-brand-100 text-brand-600 flex items-center justify-center\">\n               <iconify-icon icon=\"lucide:users-2\" class=\"text-lg\"></iconify-icon>\n             </div>\n             <div>\n               <p class=\"text-sm font-bold text-slate-900\">Equal Split</p>\n               <p class=\"text-xs text-slate-500 leading-relaxed mt-0.5\">We'll divide the total bill evenly between everyone added below.</p>\n             </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- People Manager -->\n      <section class=\"rounded-3xl bg-white shadow-md border border-slate-200 overflow-hidden\">\n        <div class=\"px-5 py-3 border-b border-slate-100 flex justify-between items-center\">\n          <h2 class=\"text-sm font-bold text-slate-900\">People</h2>\n          <span class=\"bg-slate-100 text-slate-600 px-2.5 py-0.5 rounded-lg text-xs font-bold\">3</span>\n        </div>\n        <div class=\"p-5 space-y-4\">\n          <!-- Person 1 -->\n          <div class=\"bg-slate-50 rounded-2xl p-3 border border-slate-200\">\n            <div class=\"flex items-center gap-3 mb-3\">\n              <div class=\"h-10 w-10 rounded-xl bg-indigo-500 text-white flex items-center justify-center font-bold shadow-sm text-sm\">A</div>\n              <div class=\"flex-1 min-w-0\">\n                <label for=\"p1-name\" class=\"sr-only\">Person 1 Name</label>\n                <input id=\"p1-name\" type=\"text\" value=\"Ava\" class=\"bg-transparent border-none p-0 text-sm font-bold text-slate-900 focus:ring-0 w-full\" />\n                <div class=\"text-xs text-slate-500\">33.3% share</div>\n              </div>\n              <button type=\"button\" class=\"h-8 w-8 flex items-center justify-center rounded-lg text-slate-400 hover:bg-rose-50 hover:text-rose-500 transition-colors\" aria-label=\"Remove Ava\">\n                <iconify-icon icon=\"lucide:x\" class=\"text-lg\"></iconify-icon>\n              </button>\n            </div>\n            \n            <div class=\"flex items-center gap-2\">\n              <button type=\"button\" class=\"flex-1 h-10 rounded-xl bg-white border border-slate-200 shadow-sm text-xs font-bold text-slate-700 flex items-center justify-center gap-2 hover:bg-slate-50 active:scale-95 transition-all\">\n                <iconify-icon icon=\"lucide:list-plus\" class=\"text-sm text-slate-400\"></iconify-icon>\n                Assign Items\n              </button>\n              <div class=\"px-3 h-10 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-sm font-black text-slate-800 shadow-sm min-w-[90px]\">\n                263.3k\n              </div>\n            </div>\n          </div>\n\n          <!-- Person 2 -->\n          <div class=\"bg-slate-50 rounded-2xl p-3 border border-slate-200\">\n            <div class=\"flex items-center gap-3 mb-3\">\n              <div class=\"h-10 w-10 rounded-xl bg-emerald-500 text-white flex items-center justify-center font-bold shadow-sm text-sm\">B</div>\n              <div class=\"flex-1 min-w-0\">\n                <label for=\"p2-name\" class=\"sr-only\">Person 2 Name</label>\n                <input id=\"p2-name\" type=\"text\" value=\"Ben\" class=\"bg-transparent border-none p-0 text-sm font-bold text-slate-900 focus:ring-0 w-full\" />\n                <div class=\"text-xs text-slate-500\">33.3% share</div>\n              </div>\n              <button type=\"button\" class=\"h-8 w-8 flex items-center justify-center rounded-lg text-slate-400 hover:bg-rose-50 hover:text-rose-500 transition-colors\" aria-label=\"Remove Ben\">\n                <iconify-icon icon=\"lucide:x\" class=\"text-lg\"></iconify-icon>\n              </button>\n            </div>\n             <div class=\"flex items-center gap-2\">\n              <button type=\"button\" class=\"flex-1 h-10 rounded-xl bg-white border border-slate-200 shadow-sm text-xs font-bold text-slate-700 flex items-center justify-center gap-2 hover:bg-slate-50 active:scale-95 transition-all\">\n                <iconify-icon icon=\"lucide:list-plus\" class=\"text-sm text-slate-400\"></iconify-icon>\n                Assign Items\n              </button>\n              <div class=\"px-3 h-10 rounded-xl bg-white border border-slate-200 flex items-center justify-center text-sm font-black text-slate-800 shadow-sm min-w-[90px]\">\n                263.3k\n              </div>\n            </div>\n          </div>\n\n          <!-- Add Button -->\n          <button type=\"button\" class=\"w-full h-12 rounded-2xl border-2 border-dashed border-slate-300 text-slate-500 font-bold text-sm flex items-center justify-center gap-2 hover:border-brand-300 hover:text-brand-600 hover:bg-brand-50 transition-all active:scale-[0.99]\">\n            <iconify-icon icon=\"lucide:user-plus\" class=\"text-lg\"></iconify-icon>\n            Add Person\n          </button>\n        </div>\n      </section>\n\n      <!-- Action Area -->\n      <section class=\"pt-2\">\n        <button type=\"button\" class=\"w-full h-14 rounded-2xl bg-brand-500 text-white font-extrabold text-lg shadow-lg shadow-brand-500/30 flex items-center justify-center gap-2 active:scale-[0.98] transition-all\">\n          <iconify-icon icon=\"lucide:wand-2\" class=\"text-xl\"></iconify-icon>\n          Calculate Split\n        </button>\n        \n        <button type=\"button\" class=\"mt-3 w-full h-14 rounded-2xl bg-white border border-slate-200 text-slate-700 font-bold text-sm shadow-sm flex items-center justify-center gap-2 active:scale-[0.98] transition-all hover:bg-slate-50\">\n          <iconify-icon icon=\"lucide:bookmark\" class=\"text-lg text-slate-400\"></iconify-icon>\n          Save as Template\n        </button>\n      </section>\n\n    </main>\n\n    <!-- Bottom Navigation -->\n    <footer class=\"shrink-0 pb-[34px]\">\n      <nav class=\"bg-white border-t border-slate-200 shadow-[0_-4px_6px_-1px_rgba(0,0,0,0.02)]\">\n        <div class=\"px-3 pt-2\">\n          <div class=\"grid grid-cols-4 gap-2\">\n            <a id=\"btm-nav-home\" href=\"#\" class=\"h-14 rounded-2xl inline-flex flex-col items-center justify-center gap-1 text-slate-400 hover:text-brand-600 transition-colors\">\n              <iconify-icon icon=\"lucide:home\" class=\"text-xl\"></iconify-icon>\n              <span class=\"text-[10px] font-bold\">Home</span>\n            </a>\n            <a id=\"btm-nav-history\" href=\"#\" class=\"h-14 rounded-2xl inline-flex flex-col items-center justify-center gap-1 text-slate-400 hover:text-brand-600 transition-colors\">\n              <iconify-icon icon=\"lucide:clock\" class=\"text-xl\"></iconify-icon>\n              <span class=\"text-[10px] font-bold\">History</span>\n            </a>\n            <a id=\"btm-nav-scan\" href=\"#\" class=\"h-14 rounded-2xl inline-flex flex-col items-center justify-center gap-1\">\n              <span class=\"h-11 w-11 rounded-2xl bg-brand-500 text-white shadow-lg shadow-brand-500/30 inline-flex items-center justify-center transform transition-transform active:scale-90\">\n                <iconify-icon icon=\"lucide:scan-line\" class=\"text-xl\"></iconify-icon>\n              </span>\n              <span class=\"text-[10px] font-extrabold text-brand-700\">Scan</span>\n            </a>\n            <a id=\"btm-nav-settings\" href=\"#\" class=\"h-14 rounded-2xl inline-flex flex-col items-center justify-center gap-1 text-slate-400 hover:text-brand-600 transition-colors\">\n              <iconify-icon icon=\"lucide:settings\" class=\"text-xl\"></iconify-icon>\n              <span class=\"text-[10px] font-bold\">Settings</span>\n            </a>\n          </div>\n        </div>\n      </nav>\n    </footer>\n  </div>\n</body>\n</html>"
}
