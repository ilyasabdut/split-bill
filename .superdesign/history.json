{
  "draftId": "bb82381f-9436-4d8a-9b60-0c472db2b200",
  "title": "Split Bill — History (Baseline UI Fixes)",
  "htmlContent": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <meta name=\"view-transition\" content=\"same-origin\" />\n  <title>Split Bill — History</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <script src=\"https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js\"></script>\n  <link href=\"https://api.fontshare.com/v2/css?f[]=plus-jakarta-sans@400,500,600,700&display=swap\" rel=\"stylesheet\">\n  <script>\n    tailwind.config = {\n      theme: {\n        extend: {\n          fontFamily: {\n            sans: ['\"Plus Jakarta Sans\"', 'sans-serif'],\n          },\n          colors: {\n            primary: {\n              50: '#f0f9ff',\n              100: '#e0f2fe',\n              200: '#bae6fd',\n              300: '#7dd3fc',\n              400: '#38bdf8',\n              500: '#0ea5e9',\n              600: '#0284c7',\n              700: '#0369a1'\n            }\n          },\n          borderRadius: {\n            xl: '0.75rem',\n            '2xl': '1rem',\n            '3xl': '1.5rem'\n          }\n        }\n      }\n    }\n  </script>\n  <style>\n    html { background-color: #f8fafc; }\n    @view-transition { navigation: auto; }\n    ::view-transition { background-color: #f8fafc; }\n    .no-scrollbar::-webkit-scrollbar {\n      display: none;\n    }\n    .no-scrollbar {\n      -ms-overflow-style: none;\n      scrollbar-width: none;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"w-full h-screen flex flex-col bg-slate-50 text-slate-900 font-sans\">\n    <!-- Header -->\n    <header class=\"shrink-0 pt-12 px-4 pb-2 bg-white border-b border-slate-100 sticky top-0 z-30\" style=\"view-transition-name: history-header\">\n      <div class=\"flex items-center justify-between\">\n        <div class=\"flex items-center gap-3\">\n          <div class=\"w-11 h-11 rounded-2xl bg-primary-100/50 shadow-sm flex items-center justify-center\">\n            <iconify-icon icon=\"lucide:receipt\" class=\"text-[22px] text-primary-600\"></iconify-icon>\n          </div>\n          <div>\n            <h1 class=\"text-[22px] leading-tight font-bold tracking-tight\">History</h1>\n            <p class=\"text-[12px] text-slate-500 font-medium\">Recent splits & settlements</p>\n          </div>\n        </div>\n        <a id=\"history-search-link\" href=\"#\" class=\"w-11 h-11 rounded-2xl bg-white shadow-sm border border-slate-200 flex items-center justify-center text-slate-700 active:scale-95 transition-transform\">\n          <iconify-icon icon=\"lucide:search\" class=\"text-[20px]\"></iconify-icon>\n        </a>\n      </div>\n\n      <!-- Scrollable Tabs -->\n      <nav class=\"mt-5 -mx-4 overflow-hidden\" aria-label=\"History tabs\">\n        <div class=\"flex items-center gap-2 overflow-x-auto px-4 pb-2 no-scrollbar scroll-smooth\">\n          <a id=\"tab-all\" href=\"#\" class=\"shrink-0 h-[38px] px-5 rounded-full flex items-center justify-center text-[14px] font-semibold bg-slate-900 text-white shadow-md shadow-slate-900/10\">\n            All\n          </a>\n          <a id=\"tab-unpaid\" href=\"#\" class=\"shrink-0 h-[38px] px-5 rounded-full flex items-center justify-center text-[14px] font-semibold bg-white border border-slate-200 text-slate-600 active:bg-slate-50\">\n            Unpaid\n          </a>\n          <a id=\"tab-completed\" href=\"#\" class=\"shrink-0 h-[38px] px-5 rounded-full flex items-center justify-center text-[14px] font-semibold bg-white border border-slate-200 text-slate-600 active:bg-slate-50\">\n            Completed\n          </a>\n          <a id=\"tab-groups\" href=\"#\" class=\"shrink-0 h-[38px] px-5 rounded-full flex items-center justify-center text-[14px] font-semibold bg-white border border-slate-200 text-slate-600 active:bg-slate-50\">\n            Groups\n          </a>\n          <a id=\"tab-templates\" href=\"#\" class=\"shrink-0 h-[38px] px-5 rounded-full flex items-center justify-center text-[14px] font-semibold bg-white border border-slate-200 text-slate-600 active:bg-slate-50\">\n            Templates\n          </a>\n          <a id=\"tab-analytics\" href=\"#\" class=\"shrink-0 h-[38px] px-5 rounded-full flex items-center justify-center text-[14px] font-semibold bg-white border border-slate-200 text-slate-600 active:bg-slate-50\">\n            Analytics\n          </a>\n        </div>\n      </nav>\n    </header>\n\n    <!-- Main content (scrollable) -->\n    <main class=\"flex-1 overflow-y-auto px-4 pb-[120px] pt-2\" style=\"view-transition-name: main-content\">\n      \n      <!-- Currency Selector -->\n      <div class=\"flex justify-center mb-4\">\n        <button id=\"currency-selector-btn\" class=\"flex items-center gap-2 px-4 py-1.5 bg-white border border-slate-200 rounded-full shadow-sm text-sm font-semibold text-slate-700 active:scale-95 transition-transform\">\n          <span class=\"w-5 h-5 rounded-full bg-slate-100 flex items-center justify-center text-[10px]\">🇮🇩</span>\n          IDR\n          <iconify-icon icon=\"lucide:chevron-down\" class=\"text-slate-400 text-xs\"></iconify-icon>\n        </button>\n      </div>\n\n      <!-- Monthly Spending Summary -->\n      <section class=\"mb-6 relative group\">\n        <div class=\"absolute inset-0 bg-primary-500 rounded-3xl blur-xl opacity-20 group-hover:opacity-30 transition-opacity\"></div>\n        <div class=\"relative bg-gradient-to-br from-primary-500 to-primary-600 rounded-3xl p-6 text-white shadow-xl shadow-primary-500/20 overflow-hidden\">\n          <!-- Decorative circles -->\n          <div class=\"absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-full -mr-10 -mt-10 blur-2xl\"></div>\n          \n          <div class=\"relative z-10\">\n            <div class=\"flex justify-between items-start\">\n              <p class=\"text-primary-100 text-sm font-medium\">Total spending this month</p>\n              <span class=\"bg-white/20 backdrop-blur-md px-2.5 py-1 rounded-lg text-xs font-semibold text-white flex items-center gap-1\">\n                <iconify-icon icon=\"lucide:trending-up\"></iconify-icon>\n                12.5%\n              </span>\n            </div>\n            <h2 class=\"text-[32px] font-bold tracking-tight mt-2\">IDR 4,250,000</h2>\n            <p class=\"text-xs text-primary-200 mt-1 opacity-80\">+IDR 450,000 vs last month</p>\n          </div>\n        </div>\n      </section>\n\n      <!-- Existing Summary Chips -->\n      <section class=\"mb-6 overflow-x-auto no-scrollbar\">\n        <div class=\"flex gap-3 pb-1 min-w-max\">\n          <div class=\"bg-white border border-slate-200 shadow-sm rounded-2xl pl-3 pr-4 py-2.5 flex items-center gap-3\">\n            <span class=\"w-10 h-10 rounded-xl bg-slate-50 flex items-center justify-center\">\n              <iconify-icon icon=\"lucide:users\" class=\"text-[20px] text-slate-600\"></iconify-icon>\n            </span>\n            <div>\n              <p class=\"text-[11px] uppercase tracking-wider text-slate-500 font-bold leading-tight\">People</p>\n              <p class=\"text-[15px] font-bold text-slate-900\">12 Friends</p>\n            </div>\n          </div>\n          <div class=\"bg-white border border-slate-200 shadow-sm rounded-2xl pl-3 pr-4 py-2.5 flex items-center gap-3\">\n            <span class=\"w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center\">\n              <iconify-icon icon=\"lucide:clock\" class=\"text-[20px] text-amber-600\"></iconify-icon>\n            </span>\n            <div>\n              <p class=\"text-[11px] uppercase tracking-wider text-slate-500 font-bold leading-tight\">Pending</p>\n              <p class=\"text-[15px] font-bold text-slate-900\">2 Splits</p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- Settlement Summary -->\n      <section class=\"mb-8\">\n        <h3 class=\"text-sm font-bold text-slate-900 mb-3 ml-1 flex items-center gap-2\">\n          Settlement Summary\n        </h3>\n        <div class=\"grid grid-cols-2 gap-3\">\n          <!-- You Owe -->\n          <div class=\"bg-rose-50 border border-rose-100 p-4 rounded-2xl active:scale-95 transition-transform cursor-pointer\">\n            <div class=\"w-10 h-10 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center mb-3\">\n              <iconify-icon icon=\"lucide:arrow-up-right\" class=\"text-xl\"></iconify-icon>\n            </div>\n            <p class=\"text-xs text-rose-600 font-semibold uppercase tracking-wide\">You Owe</p>\n            <p class=\"text-xl font-bold text-rose-950 mt-1\">IDR 150k</p>\n            <div class=\"mt-2 flex items-center gap-1.5\">\n              <div class=\"w-5 h-5 rounded-full bg-rose-200 border border-white text-[9px] flex items-center justify-center font-bold text-rose-800\">S</div>\n              <p class=\"text-[11px] text-rose-700 font-medium truncate\">to Sarah</p>\n            </div>\n          </div>\n\n          <!-- Owed to You -->\n          <div class=\"bg-emerald-50 border border-emerald-100 p-4 rounded-2xl active:scale-95 transition-transform cursor-pointer\">\n            <div class=\"w-10 h-10 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mb-3\">\n              <iconify-icon icon=\"lucide:arrow-down-left\" class=\"text-xl\"></iconify-icon>\n            </div>\n            <p class=\"text-xs text-emerald-600 font-semibold uppercase tracking-wide\">Owed to You</p>\n            <p class=\"text-xl font-bold text-emerald-950 mt-1\">IDR 320k</p>\n            <div class=\"mt-2 flex items-center gap-1.5\">\n              <div class=\"w-5 h-5 rounded-full bg-emerald-200 border border-white text-[9px] flex items-center justify-center font-bold text-emerald-800\">M</div>\n              <p class=\"text-[11px] text-emerald-700 font-medium truncate\">from Mike</p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- Split cards -->\n      <section aria-label=\"Split list\">\n        <div class=\"flex items-center justify-between mb-4\">\n          <h2 class=\"text-[16px] font-bold text-slate-900\">Recent Activity</h2>\n          <a id=\"history-view-all-link\" href=\"#\" class=\"h-8 px-3 rounded-lg hover:bg-slate-100 inline-flex items-center justify-center text-[13px] font-semibold text-primary-600 transition-colors\">\n            View all\n          </a>\n        </div>\n\n        <div class=\"space-y-4\">\n          <!-- Card 1: Unpaid -->\n          <a id=\"history-split-1-link\" href=\"#\" class=\"group block bg-white border border-slate-200 shadow-sm rounded-2xl p-4 active:scale-[0.99] transition-all relative overflow-hidden\">\n            <!-- Status Line Indicator -->\n            <div class=\"absolute left-0 top-0 bottom-0 w-1 bg-amber-400\"></div>\n            \n            <div class=\"flex items-start gap-4\">\n              <div class=\"w-12 h-12 rounded-2xl bg-slate-50 border border-slate-100 flex items-center justify-center shrink-0 group-hover:bg-primary-50 group-hover:border-primary-100 transition-colors\">\n                <iconify-icon icon=\"lucide:utensils\" class=\"text-[22px] text-slate-700 group-hover:text-primary-600 transition-colors\"></iconify-icon>\n              </div>\n              <div class=\"flex-1 min-w-0\">\n                <div class=\"flex items-start justify-between gap-3\">\n                  <div class=\"min-w-0\">\n                    <h3 class=\"text-[15px] font-bold text-slate-900 truncate\">Sushi Night</h3>\n                    <p class=\"text-[12px] text-slate-500 mt-0.5\">Jan 18, 7:42 PM</p>\n                  </div>\n                  <div class=\"text-right shrink-0\">\n                    <p class=\"text-[17px] font-bold text-slate-900 leading-none\">IDR 860k</p>\n                    <span class=\"mt-2 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-50 text-amber-700 border border-amber-100\">\n                      <span class=\"w-1.5 h-1.5 rounded-full bg-amber-500\"></span>\n                      Unpaid\n                    </span>\n                  </div>\n                </div>\n\n                <div class=\"mt-3 pt-3 border-t border-slate-50 flex items-center justify-between\">\n                  <div class=\"flex items-center gap-2 text-slate-500\">\n                    <iconify-icon icon=\"lucide:users\" class=\"text-[14px]\"></iconify-icon>\n                    <span class=\"text-[12px] font-medium\">4 people</span>\n                  </div>\n                  <div class=\"flex -space-x-2\">\n                    <div class=\"w-6 h-6 rounded-full bg-slate-200 ring-2 ring-white flex items-center justify-center text-[9px] font-bold text-slate-700\">A</div>\n                    <div class=\"w-6 h-6 rounded-full bg-primary-200 ring-2 ring-white flex items-center justify-center text-[9px] font-bold text-primary-800\">J</div>\n                    <div class=\"w-6 h-6 rounded-full bg-emerald-200 ring-2 ring-white flex items-center justify-center text-[9px] font-bold text-emerald-800\">M</div>\n                    <div class=\"w-6 h-6 rounded-full bg-amber-200 ring-2 ring-white flex items-center justify-center text-[9px] font-bold text-amber-900\">S</div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </a>\n\n          <!-- Card 2: Completed -->\n          <a id=\"history-split-2-link\" href=\"#\" class=\"group block bg-white border border-slate-200 shadow-sm rounded-2xl p-4 active:scale-[0.99] transition-all relative overflow-hidden\">\n             <!-- Status Line Indicator -->\n             <div class=\"absolute left-0 top-0 bottom-0 w-1 bg-emerald-500\"></div>\n             \n             <div class=\"flex items-start gap-4\">\n              <div class=\"w-12 h-12 rounded-2xl bg-emerald-50 border border-emerald-100 flex items-center justify-center shrink-0\">\n                <iconify-icon icon=\"lucide:car\" class=\"text-[22px] text-emerald-600\"></iconify-icon>\n              </div>\n              <div class=\"flex-1 min-w-0\">\n                <div class=\"flex items-start justify-between gap-3\">\n                  <div class=\"min-w-0\">\n                    <h3 class=\"text-[15px] font-bold text-slate-900 truncate\">Road Trip Gas</h3>\n                    <p class=\"text-[12px] text-slate-500 mt-0.5\">Jan 12, 9:10 AM</p>\n                  </div>\n                  <div class=\"text-right shrink-0\">\n                    <p class=\"text-[17px] font-bold text-slate-900 leading-none\">IDR 540k</p>\n                    <div class=\"mt-1.5 flex flex-col items-end\">\n                      <span class=\"inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-bold text-emerald-700 bg-emerald-50\">\n                        <iconify-icon icon=\"lucide:check-circle-2\" class=\"text-[12px]\"></iconify-icon>\n                        Completed\n                      </span>\n                      <span class=\"text-[10px] text-slate-400 font-medium\">Paid on Jan 14</span>\n                    </div>\n                  </div>\n                </div>\n\n                <div class=\"mt-3 pt-3 border-t border-slate-50 flex items-center justify-between\">\n                  <div class=\"flex items-center gap-2 text-slate-500\">\n                    <iconify-icon icon=\"lucide:users\" class=\"text-[14px]\"></iconify-icon>\n                    <span class=\"text-[12px] font-medium\">3 people</span>\n                  </div>\n                  <div class=\"flex -space-x-2\">\n                    <div class=\"w-6 h-6 rounded-full bg-primary-200 ring-2 ring-white flex items-center justify-center text-[9px] font-bold text-primary-800\">K</div>\n                    <div class=\"w-6 h-6 rounded-full bg-slate-200 ring-2 ring-white flex items-center justify-center text-[9px] font-bold text-slate-700\">D</div>\n                    <div class=\"w-6 h-6 rounded-full bg-emerald-200 ring-2 ring-white flex items-center justify-center text-[9px] font-bold text-emerald-800\">R</div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </a>\n\n          <!-- Card 3: Unpaid -->\n          <a id=\"history-split-3-link\" href=\"#\" class=\"group block bg-white border border-slate-200 shadow-sm rounded-2xl p-4 active:scale-[0.99] transition-all relative overflow-hidden\">\n            <!-- Status Line Indicator -->\n            <div class=\"absolute left-0 top-0 bottom-0 w-1 bg-amber-400\"></div>\n            \n            <div class=\"flex items-start gap-4\">\n              <div class=\"w-12 h-12 rounded-2xl bg-slate-50 border border-slate-100 flex items-center justify-center shrink-0 group-hover:bg-primary-50 group-hover:border-primary-100 transition-colors\">\n                <iconify-icon icon=\"lucide:shopping-basket\" class=\"text-[22px] text-slate-700 group-hover:text-primary-600 transition-colors\"></iconify-icon>\n              </div>\n              <div class=\"flex-1 min-w-0\">\n                <div class=\"flex items-start justify-between gap-3\">\n                  <div class=\"min-w-0\">\n                    <h3 class=\"text-[15px] font-bold text-slate-900 truncate\">Groceries</h3>\n                    <p class=\"text-[12px] text-slate-500 mt-0.5\">Jan 03, 6:28 PM</p>\n                  </div>\n                  <div class=\"text-right shrink-0\">\n                    <p class=\"text-[17px] font-bold text-slate-900 leading-none\">IDR 1.2M</p>\n                    <span class=\"mt-2 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-50 text-amber-700 border border-amber-100\">\n                      <span class=\"w-1.5 h-1.5 rounded-full bg-amber-500\"></span>\n                      Unpaid\n                    </span>\n                  </div>\n                </div>\n\n                <div class=\"mt-3 pt-3 border-t border-slate-50 flex items-center justify-between\">\n                  <div class=\"flex items-center gap-2 text-slate-500\">\n                    <iconify-icon icon=\"lucide:users\" class=\"text-[14px]\"></iconify-icon>\n                    <span class=\"text-[12px] font-medium\">2 people</span>\n                  </div>\n                  <div class=\"flex -space-x-2\">\n                    <div class=\"w-6 h-6 rounded-full bg-amber-200 ring-2 ring-white flex items-center justify-center text-[9px] font-bold text-amber-900\">L</div>\n                    <div class=\"w-6 h-6 rounded-full bg-primary-200 ring-2 ring-white flex items-center justify-center text-[9px] font-bold text-primary-800\">T</div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </a>\n        </div>\n      </section>\n    </main>\n\n    <!-- Bottom navigation -->\n    <footer class=\"shrink-0 pb-[34px] bg-white border-t border-slate-100 z-40\" style=\"view-transition-name: bottom-nav\">\n      <nav class=\"px-3 pt-2\">\n        <div class=\"grid grid-cols-4 items-end\">\n          <a id=\"bottomnav-home-link\" href=\"#\" class=\"min-h-[56px] flex flex-col items-center justify-center gap-1.5 text-slate-400 hover:text-slate-600 transition-colors group\">\n            <iconify-icon icon=\"lucide:home\" class=\"text-[24px] group-hover:-translate-y-0.5 transition-transform\"></iconify-icon>\n            <span class=\"text-[11px] font-semibold\">Home</span>\n          </a>\n\n          <a id=\"bottomnav-history-link\" href=\"#\" class=\"min-h-[56px] flex flex-col items-center justify-center gap-1.5 text-primary-600\">\n            <iconify-icon icon=\"lucide:history\" class=\"text-[24px]\"></iconify-icon>\n            <span class=\"text-[11px] font-bold\">History</span>\n          </a>\n\n          <a id=\"bottomnav-scan-link\" href=\"#\" class=\"min-h-[56px] flex flex-col items-center justify-center gap-1 relative z-10\">\n            <span class=\"w-14 h-14 rounded-full bg-primary-500 shadow-lg shadow-primary-500/40 flex items-center justify-center -mt-8 border-[5px] border-slate-50 group active:scale-95 transition-transform\">\n              <iconify-icon icon=\"lucide:scan-line\" class=\"text-[24px] text-white\"></iconify-icon>\n            </span>\n            <span class=\"text-[11px] font-semibold text-slate-500 mt-1\">Scan</span>\n          </a>\n\n          <a id=\"bottomnav-settings-link\" href=\"#\" class=\"min-h-[56px] flex flex-col items-center justify-center gap-1.5 text-slate-400 hover:text-slate-600 transition-colors group\">\n            <iconify-icon icon=\"lucide:settings-2\" class=\"text-[24px] group-hover:-translate-y-0.5 transition-transform\"></iconify-icon>\n            <span class=\"text-[11px] font-semibold\">Settings</span>\n          </a>\n        </div>\n      </nav>\n    </footer>\n  </div>\n</body>\n</html>"
}
