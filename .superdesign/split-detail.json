{
  "draftId": "ff438ba1-996f-4d53-ad58-13da80da7786",
  "title": "Enhanced Split Detail — Split Bill",
  "htmlContent": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  <meta name=\"view-transition\" content=\"same-origin\" />\n  <title>Split Bill — Split Detail</title>\n  <script src=\"https://cdn.tailwindcss.com\"></script>\n  <script src=\"https://code.iconify.design/iconify-icon/1.0.7/iconify-icon.min.js\"></script>\n  <style>\n    html{background:#f8fafc;}\n    @view-transition { navigation: auto; }\n    ::view-transition{ background-color:#f8fafc; }\n    ::view-transition-old(root),\n    ::view-transition-new(root){ animation:none; mix-blend-mode:normal; }\n    ::view-transition-old(main-content){ animation:0.25s ease-out both fade-out; }\n    ::view-transition-new(main-content){ animation:0.25s ease-in 0.1s both fade-in; }\n    @keyframes fade-out{ from{opacity:1} to{opacity:0} }\n    @keyframes fade-in{ from{opacity:0} to{opacity:1} }\n  </style>\n  <script>\n    tailwind.config = {\n      theme: {\n        extend: {\n          colors: {\n            brand: {\n              50: '#f0f9ff',\n              100: '#e0f2fe',\n              200: '#bae6fd',\n              300: '#7dd3fc',\n              400: '#38bdf8',\n              500: '#0ea5e9',\n              600: '#0284c7',\n              700: '#0369a1'\n            }\n          },\n          borderRadius: {\n            xl: '1rem'\n          }\n        }\n      }\n    }\n  </script>\n</head>\n<body>\n  <div class=\"w-full h-screen flex flex-col bg-slate-50 text-slate-900\" aria-label=\"Split detail screen\">\n    <!-- Header (safe area) -->\n    <header class=\"shrink-0 pt-14 px-4\">\n      <div class=\"flex items-start justify-between gap-3\" style=\"view-transition-name: split-detail-header\">\n        <a id=\"nav-back\" href=\"#\" class=\"shrink-0 inline-flex items-center justify-center w-11 h-11 rounded-xl bg-white shadow-md border border-slate-200 active:scale-[0.99]\">\n          <iconify-icon icon=\"lucide:chevron-left\" class=\"text-xl text-slate-700\"></iconify-icon>\n          <span class=\"sr-only\">Back</span>\n        </a>\n\n        <div class=\"min-w-0 flex-1\">\n          <div class=\"flex items-center gap-2\">\n            <span class=\"inline-flex items-center justify-center w-7 h-7 rounded-lg bg-brand-100 text-brand-700\">\n              <iconify-icon icon=\"lucide:receipt\" class=\"text-base\"></iconify-icon>\n            </span>\n            <p class=\"text-xs font-semibold text-brand-700\">Split Detail</p>\n          </div>\n          <h1 class=\"mt-1 text-lg font-semibold leading-tight truncate\">Dinner at Nori House</h1>\n        </div>\n\n        <button id=\"btn-more\" type=\"button\" class=\"shrink-0 inline-flex items-center justify-center w-11 h-11 rounded-xl bg-white shadow-md border border-slate-200 active:scale-[0.99]\" aria-label=\"More actions\">\n          <iconify-icon icon=\"lucide:more-vertical\" class=\"text-xl text-slate-700\"></iconify-icon>\n        </button>\n      </div>\n\n      <!-- Amount summary card -->\n      <section class=\"mt-4 rounded-xl bg-white shadow-md border border-slate-200 p-4\">\n        <div class=\"flex items-start justify-between gap-4\">\n          <div class=\"min-w-0\">\n            <p class=\"text-xs font-medium text-slate-500\">Total bill</p>\n            <div class=\"mt-1 flex items-baseline gap-1\">\n              <p class=\"text-3xl font-semibold tracking-tight\">$84.60</p>\n              <span class=\"text-sm font-medium text-slate-400\">USD</span>\n            </div>\n            <p class=\"text-xs text-slate-400 font-medium\">≈ €78.50 EUR</p>\n            \n            <div class=\"mt-3 flex flex-wrap items-center gap-2\">\n              <span class=\"inline-flex items-center gap-1.5 rounded-full bg-brand-50 text-brand-700 px-3 py-1 text-xs font-semibold border border-brand-100\">\n                <iconify-icon icon=\"lucide:users\" class=\"text-sm\"></iconify-icon>\n                4 people\n              </span>\n              <span class=\"inline-flex items-center gap-1.5 rounded-full bg-slate-50 text-slate-700 px-3 py-1 text-xs font-semibold border border-slate-200\">\n                <iconify-icon icon=\"lucide:percent\" class=\"text-sm\"></iconify-icon>\n                Tip included\n              </span>\n            </div>\n          </div>\n          <div class=\"shrink-0\">\n            <div class=\"w-14 h-14 rounded-2xl bg-brand-500 text-white shadow-md flex items-center justify-center\">\n              <iconify-icon icon=\"lucide:split\" class=\"text-2xl\"></iconify-icon>\n            </div>\n          </div>\n        </div>\n      </section>\n    </header>\n\n    <!-- Main content -->\n    <main class=\"flex-1 overflow-y-auto px-4 pb-[34px]\" style=\"view-transition-name: main-content\">\n      \n      <!-- Settlement Overview -->\n      <section class=\"mt-4\">\n        <h2 class=\"text-sm font-semibold text-slate-900 mb-3 px-1\">Settlement</h2>\n        <div class=\"bg-white rounded-xl shadow-md border border-slate-200 overflow-hidden\">\n          <div class=\"p-4 grid gap-4\">\n            <!-- Row 1 -->\n            <div class=\"flex items-center justify-between\">\n              <div class=\"flex items-center gap-3\">\n                <div class=\"w-8 h-8 rounded-full bg-violet-100 text-violet-700 flex items-center justify-center text-xs font-bold\">M</div>\n                <div class=\"flex flex-col\">\n                  <span class=\"text-sm font-medium text-slate-900\">Maya owes you</span>\n                </div>\n              </div>\n              <div class=\"flex items-center gap-2\">\n                <span class=\"text-sm font-bold text-slate-900\">$21.15</span>\n                <iconify-icon icon=\"lucide:arrow-right\" class=\"text-slate-400\"></iconify-icon>\n              </div>\n            </div>\n            <!-- Row 2 -->\n             <div class=\"flex items-center justify-between\">\n              <div class=\"flex items-center gap-3\">\n                <div class=\"w-8 h-8 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center text-xs font-bold\">S</div>\n                <div class=\"flex flex-col\">\n                  <span class=\"text-sm font-medium text-slate-900\">Sam owes you</span>\n                </div>\n              </div>\n              <div class=\"flex items-center gap-2\">\n                <span class=\"text-sm font-bold text-slate-900\">$21.15</span>\n                <iconify-icon icon=\"lucide:arrow-right\" class=\"text-slate-400\"></iconify-icon>\n              </div>\n            </div>\n          </div>\n          <div class=\"bg-slate-50 px-4 py-2 border-t border-slate-200 text-center\">\n             <p class=\"text-xs text-slate-500\">Total receivable: <span class=\"font-semibold text-slate-700\">$42.30</span></p>\n          </div>\n        </div>\n      </section>\n\n      <!-- Receipt & Items -->\n      <section class=\"mt-6 grid gap-4\">\n        <!-- Itemized Breakdown -->\n        <div>\n           <h2 class=\"text-sm font-semibold text-slate-900 mb-3 px-1\">Items</h2>\n           <div class=\"bg-white rounded-xl shadow-md border border-slate-200 overflow-hidden\">\n              <div class=\"divide-y divide-slate-100\">\n                <div class=\"p-3 flex items-center justify-between\">\n                  <div class=\"flex items-center gap-3\">\n                    <span class=\"w-8 h-8 rounded-lg bg-orange-50 text-orange-600 flex items-center justify-center\">\n                      <iconify-icon icon=\"lucide:fish\" class=\"text-lg\"></iconify-icon>\n                    </span>\n                    <div>\n                      <p class=\"text-sm font-medium text-slate-900\">Salmon Roll</p>\n                      <p class=\"text-xs text-slate-500\">Ava</p>\n                    </div>\n                  </div>\n                  <span class=\"text-sm font-semibold text-slate-700\">$18.50</span>\n                </div>\n                \n                <div class=\"p-3 flex items-center justify-between\">\n                   <div class=\"flex items-center gap-3\">\n                    <span class=\"w-8 h-8 rounded-lg bg-yellow-50 text-yellow-600 flex items-center justify-center\">\n                      <iconify-icon icon=\"lucide:soup\" class=\"text-lg\"></iconify-icon>\n                    </span>\n                    <div>\n                      <p class=\"text-sm font-medium text-slate-900\">Miso Soup</p>\n                      <p class=\"text-xs text-slate-500\">Maya</p>\n                    </div>\n                  </div>\n                  <span class=\"text-sm font-semibold text-slate-700\">$8.00</span>\n                </div>\n\n                <div class=\"p-3 flex items-center justify-between bg-slate-50/50\">\n                  <div class=\"pl-11\">\n                    <p class=\"text-xs font-medium text-slate-500\">+ 4 more items</p>\n                  </div>\n                  <button class=\"text-xs font-semibold text-brand-600 flex items-center gap-1\">\n                    View all <iconify-icon icon=\"lucide:chevron-down\"></iconify-icon>\n                  </button>\n                </div>\n              </div>\n           </div>\n        </div>\n\n        <!-- Receipt Thumbnail -->\n        <div class=\"rounded-xl bg-white shadow-md border border-slate-200 p-4\">\n          <div class=\"flex items-center justify-between mb-3\">\n            <h2 class=\"text-sm font-semibold\">Receipt</h2>\n            <a id=\"view-receipt\" href=\"#\" class=\"inline-flex items-center justify-center h-8 px-3 rounded-lg bg-slate-100 text-xs font-semibold text-slate-700 hover:bg-slate-200 transition-colors\">\n              Full View\n            </a>\n          </div>\n          <button type=\"button\" class=\"w-full rounded-xl border border-slate-200 bg-slate-50 overflow-hidden active:scale-[0.99] transition-transform\">\n            <div class=\"relative h-24 bg-gradient-to-r from-slate-100 to-slate-200 flex items-center justify-center\">\n               <div class=\"flex items-center gap-2 text-slate-400\">\n                  <iconify-icon icon=\"lucide:image\" class=\"text-xl\"></iconify-icon>\n                  <span class=\"text-xs font-medium\">Receipt_2024.jpg</span>\n               </div>\n            </div>\n          </button>\n          <div class=\"mt-3 grid grid-cols-2 gap-3 text-xs\">\n            <div class=\"flex flex-col\">\n              <span class=\"text-slate-500\">Date</span>\n              <span class=\"font-semibold text-slate-900\">Mar 15, 2024</span>\n            </div>\n            <div class=\"flex flex-col\">\n              <span class=\"text-slate-500\">Time</span>\n              <span class=\"font-semibold text-slate-900\">7:42 PM</span>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- Breakdown with Payment Status -->\n      <section class=\"mt-6 rounded-xl bg-white shadow-md border border-slate-200 overflow-hidden\">\n        <div class=\"p-4 flex items-center justify-between gap-3 bg-slate-50/50 border-b border-slate-100\">\n          <div>\n            <h2 class=\"text-sm font-semibold\">Breakdown</h2>\n            <p class=\"text-xs text-slate-500 mt-0.5\">Includes tax & tip</p>\n          </div>\n          <iconify-icon icon=\"lucide:calculator\" class=\"text-slate-400\"></iconify-icon>\n        </div>\n\n        <div class=\"divide-y divide-slate-100\">\n          <!-- Person 1 (Paid) -->\n          <div class=\"p-4\">\n            <div class=\"flex items-start gap-3\">\n              <div class=\"shrink-0 w-10 h-10 rounded-full bg-brand-100 text-brand-700 flex items-center justify-center font-bold text-sm\">A</div>\n              <div class=\"flex-1 min-w-0\">\n                <div class=\"flex items-center justify-between\">\n                  <p class=\"text-sm font-semibold text-slate-900\">Ava (You)</p>\n                  <p class=\"text-sm font-bold text-slate-900\">$21.15</p>\n                </div>\n                <div class=\"mt-1 flex items-center justify-between\">\n                   <span class=\"text-xs text-slate-500\">25% share</span>\n                   <span class=\"inline-flex items-center gap-1 rounded-full bg-emerald-50 text-emerald-700 px-2 py-0.5 text-[10px] font-bold border border-emerald-100 uppercase tracking-wide\">\n                    <iconify-icon icon=\"lucide:check\" class=\"text-xs\"></iconify-icon> Paid\n                  </span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Person 2 (Unpaid, Link Sent) -->\n          <div class=\"p-4\">\n             <div class=\"flex items-start gap-3\">\n              <div class=\"shrink-0 w-10 h-10 rounded-full bg-violet-100 text-violet-700 flex items-center justify-center font-bold text-sm\">M</div>\n              <div class=\"flex-1 min-w-0\">\n                <div class=\"flex items-center justify-between\">\n                  <p class=\"text-sm font-semibold text-slate-900\">Maya</p>\n                  <p class=\"text-sm font-bold text-slate-900\">$21.15</p>\n                </div>\n                <div class=\"mt-1 flex items-center justify-between\">\n                   <div class=\"flex items-center gap-1.5 text-xs text-brand-600\">\n                      <iconify-icon icon=\"lucide:send\" class=\"text-[10px]\"></iconify-icon>\n                      <span>Link sent</span>\n                   </div>\n                   <span class=\"inline-flex items-center gap-1 rounded-full bg-amber-50 text-amber-700 px-2 py-0.5 text-[10px] font-bold border border-amber-100 uppercase tracking-wide\">\n                    <iconify-icon icon=\"lucide:clock\" class=\"text-xs\"></iconify-icon> Unpaid\n                  </span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Person 3 (Paid) -->\n          <div class=\"p-4\">\n             <div class=\"flex items-start gap-3\">\n              <div class=\"shrink-0 w-10 h-10 rounded-full bg-rose-100 text-rose-700 flex items-center justify-center font-bold text-sm\">J</div>\n              <div class=\"flex-1 min-w-0\">\n                <div class=\"flex items-center justify-between\">\n                  <p class=\"text-sm font-semibold text-slate-900\">Jordan</p>\n                  <p class=\"text-sm font-bold text-slate-900\">$21.15</p>\n                </div>\n                <div class=\"mt-1 flex items-center justify-between\">\n                   <span class=\"text-xs text-slate-500\">Paid via Venmo</span>\n                   <span class=\"inline-flex items-center gap-1 rounded-full bg-emerald-50 text-emerald-700 px-2 py-0.5 text-[10px] font-bold border border-emerald-100 uppercase tracking-wide\">\n                    <iconify-icon icon=\"lucide:check\" class=\"text-xs\"></iconify-icon> Paid\n                  </span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Person 4 (Unpaid, Clicked) -->\n          <div class=\"p-4\">\n             <div class=\"flex items-start gap-3\">\n              <div class=\"shrink-0 w-10 h-10 rounded-full bg-amber-100 text-amber-700 flex items-center justify-center font-bold text-sm\">S</div>\n              <div class=\"flex-1 min-w-0\">\n                <div class=\"flex items-center justify-between\">\n                  <p class=\"text-sm font-semibold text-slate-900\">Sam</p>\n                  <p class=\"text-sm font-bold text-slate-900\">$21.15</p>\n                </div>\n                <div class=\"mt-1 flex items-center justify-between\">\n                   <div class=\"flex items-center gap-1.5 text-xs text-blue-600\">\n                      <iconify-icon icon=\"lucide:mouse-pointer-2\" class=\"text-[10px]\"></iconify-icon>\n                      <span>Link clicked 5m ago</span>\n                   </div>\n                   <span class=\"inline-flex items-center gap-1 rounded-full bg-amber-50 text-amber-700 px-2 py-0.5 text-[10px] font-bold border border-amber-100 uppercase tracking-wide\">\n                    <iconify-icon icon=\"lucide:clock\" class=\"text-xs\"></iconify-icon> Unpaid\n                  </span>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- Activity Timeline -->\n      <section class=\"mt-6\">\n        <h2 class=\"text-sm font-semibold text-slate-900 mb-3 px-1\">Activity</h2>\n        <div class=\"ml-2 pl-4 border-l-2 border-slate-200 space-y-6 relative\">\n          <!-- Timeline Item 1 -->\n          <div class=\"relative\">\n             <span class=\"absolute -left-[21px] top-0.5 w-3 h-3 rounded-full bg-emerald-500 ring-4 ring-white\"></span>\n             <p class=\"text-sm text-slate-800\"><span class=\"font-semibold\">Jordan</span> marked as paid</p>\n             <p class=\"text-xs text-slate-400 mt-0.5\">2 hours ago</p>\n          </div>\n          <!-- Timeline Item 2 -->\n          <div class=\"relative\">\n             <span class=\"absolute -left-[21px] top-0.5 w-3 h-3 rounded-full bg-slate-300 ring-4 ring-white\"></span>\n             <p class=\"text-sm text-slate-800\"><span class=\"font-semibold\">You</span> sent payment requests</p>\n             <p class=\"text-xs text-slate-400 mt-0.5\">5 hours ago</p>\n          </div>\n          <!-- Timeline Item 3 -->\n           <div class=\"relative\">\n             <span class=\"absolute -left-[21px] top-0.5 w-3 h-3 rounded-full bg-slate-300 ring-4 ring-white\"></span>\n             <p class=\"text-sm text-slate-800\">Receipt uploaded</p>\n             <p class=\"text-xs text-slate-400 mt-0.5\">Yesterday, 7:45 PM</p>\n          </div>\n        </div>\n      </section>\n\n      <!-- Enhanced Actions -->\n      <section class=\"mt-8\">\n        <h2 class=\"text-sm font-semibold text-slate-900 mb-3\">Actions</h2>\n        \n        <!-- Primary Action -->\n        <button type=\"button\" class=\"w-full flex items-center justify-center gap-2 h-12 rounded-xl bg-brand-600 shadow-md text-white text-base font-semibold active:scale-[0.98] transition-all mb-3\">\n          <iconify-icon icon=\"lucide:banknote\" class=\"text-xl\"></iconify-icon>\n          Request Payment\n        </button>\n\n        <!-- Secondary Grid -->\n        <div class=\"grid grid-cols-2 gap-3\">\n          <button type=\"button\" class=\"inline-flex items-center justify-center gap-2 h-12 rounded-xl bg-white shadow-sm border border-slate-200 text-sm font-semibold text-slate-700 active:scale-[0.98]\">\n            <iconify-icon icon=\"lucide:check-circle-2\" class=\"text-lg text-emerald-600\"></iconify-icon>\n            Mark Paid\n          </button>\n\n          <a id=\"action-share\" href=\"#\" class=\"inline-flex items-center justify-center gap-2 h-12 rounded-xl bg-white shadow-sm border border-slate-200 text-sm font-semibold text-slate-700 active:scale-[0.98]\">\n            <iconify-icon icon=\"lucide:qr-code\" class=\"text-lg\"></iconify-icon>\n            Share / QR\n          </a>\n\n          <button type=\"button\" class=\"inline-flex items-center justify-center gap-2 h-12 rounded-xl bg-white shadow-sm border border-slate-200 text-sm font-semibold text-slate-700 active:scale-[0.98]\">\n            <iconify-icon icon=\"lucide:sticky-note\" class=\"text-lg\"></iconify-icon>\n            Add Note\n          </button>\n          \n           <a id=\"action-edit\" href=\"#\" class=\"inline-flex items-center justify-center gap-2 h-12 rounded-xl bg-white shadow-sm border border-slate-200 text-sm font-semibold text-slate-700 active:scale-[0.98]\">\n            <iconify-icon icon=\"lucide:pencil\" class=\"text-lg\"></iconify-icon>\n            Edit Split\n          </a>\n        </div>\n        \n        <button type=\"button\" class=\"mt-3 w-full inline-flex items-center justify-center gap-2 h-12 rounded-xl text-sm font-semibold text-rose-600 hover:bg-rose-50 active:scale-[0.98] transition-colors\">\n            <iconify-icon icon=\"lucide:trash-2\" class=\"text-lg\"></iconify-icon>\n            Delete Split\n        </button>\n\n        <!-- Pro Tip -->\n        <div class=\"mt-6 rounded-xl bg-gradient-to-r from-brand-50 to-indigo-50 border border-brand-100 p-4\">\n          <div class=\"flex items-start gap-3\">\n            <div class=\"shrink-0 w-8 h-8 rounded-lg bg-white/80 border border-brand-100 text-brand-600 flex items-center justify-center shadow-sm\">\n              <iconify-icon icon=\"lucide:lightbulb\" class=\"text-lg\"></iconify-icon>\n            </div>\n            <div class=\"min-w-0\">\n              <p class=\"text-sm font-semibold text-slate-900\">Pro tip</p>\n              <p class=\"mt-1 text-xs text-slate-600 leading-relaxed\">\n                Send payment requests via Venmo or PayPal links for faster settlements. Everyone can mark themselves as paid to keep the group in sync!\n              </p>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      <!-- Bottom Spacer -->\n      <div class=\"h-6\"></div>\n    </main>\n  </div>\n</body>\n</html>"
}
